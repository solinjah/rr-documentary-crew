# Copy this file to .env and fill in ONE model provider. Never commit .env.
#
# Option A: Anthropic (Claude)
MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=
#
# Option B: OpenAI
# MODEL=gpt-4o
# OPENAI_API_KEY=
#
# Optional: web search for the Researcher (https://serper.dev, free tier available)
SERPER_API_KEY=
#
# Where finished packages are written (default: ./output)
OUTPUT_DIR=output
